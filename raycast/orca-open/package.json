{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "orca-open",
  "title": "Orca Open",
  "description": "リポジトリを選んで Orca で開く",
  "icon": "extension-icon.png",
  "author": "jion_kozono",
  "license": "MIT",
  "commands": [
    {
      "name": "open-in-orca",
      "title": "Open in Orca",
      "description": "リポジトリを絞り込んで Orca で開く",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.8.2",
    "@raycast/utils": "^2.3.2"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "22.19.17",
    "@types/react": "19.0.10",
    "eslint": "^9.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
